# Copy this file to .env. Never commit .env or paste keys into chat.
# Gemini is called by the n8n workflow with its own n8n credential; Billflow needs no Gemini key.
# Server-only n8n webhook credential. Keep the value out of browser code and logs.
BILL_AI_WEBHOOK_SECRET=
PORT=3000
# Server-only production invoice-upload webhook URL. It must use HTTPS, the configured
# n8n Cloud host, and a /webhook/ path. Never expose it to browser code.
N8N_WEBHOOK_URL=
# Optional but recommended: configure this exact value as n8n Webhook Header Auth
# (header name x-bill-agent-secret). Keep it in .env, never in source control.
N8N_SHARED_SECRET=
# Optional: local invoice history file (JSON, relative to the project root). Keep it out of source control.
BILL_AI_HISTORY_FILE=data/invoices.json
